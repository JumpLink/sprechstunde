{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/*.json",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "web/**/*.svelte",
    "**/node_modules",
    "**/dist",
    "**/coverage"
  ]
}
