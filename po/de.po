#: src/cli/sip-contacts.ts:25
msgid "usage: sip-contacts [list|clear] [--ipv4|--ipv6]"
msgstr "Aufruf: sip-contacts [list|clear] [--ipv4|--ipv6]"

#: src/cli/sip-contacts.ts:26
msgid ""
"Asks the provider registrar how many contacts it holds for SIP_PROVIDER_USER."
msgstr ""
"Fragt den Registrar des Anbieters, wie viele Kontakte er für "
"SIP_PROVIDER_USER hält."

#: src/cli/sip-contacts.ts:27
msgid ""
"  clear   remove every contact (REGISTER with Contact: * and Expires: 0)"
msgstr ""
"  clear   alle Kontakte entfernen (REGISTER mit Contact: * und Expires: 0)"

#: src/cli/sip-contacts.ts:28
msgid "  --ipv4, --ipv6  address family; default follows SIP_PROVIDER_IPV6"
msgstr ""
"  --ipv4, --ipv6  Adressfamilie; Vorgabe richtet sich nach SIP_PROVIDER_IPV6"

#: src/cli/sip-contacts.ts:29
msgid "Prints only status lines and counts, never contact addresses."
msgstr "Gibt nur Statuszeilen und Anzahlen aus, nie Kontaktadressen."

#: src/cli/sip-contacts.ts:57
