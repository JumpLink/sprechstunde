#: src/cli/metrics.ts:29
msgid ""
"usage: metrics [--since <ISO|date>] [--until <ISO|date>] [--day <YYYY-MM-"
"DD>] [--calls] [--json]"
msgstr ""
"Aufruf: metrics [--since <ISO|Datum>] [--until <ISO|Datum>] [--day <JJJJ-MM-"
"TT>] [--calls] [--json]"

#: src/cli/metrics.ts:30
msgid ""
"Reads <SPRECHSTUNDE_METRICS_DIR or var/metrics>/<date>.jsonl and prints n, "
"p50, p95 and max per metric."
msgstr ""
"Liest <SPRECHSTUNDE_METRICS_DIR oder var/metrics>/<Datum>.jsonl und gibt n, "
"p50, p95 und max je Metrik aus."

#: src/cli/metrics.ts:31
msgid ""
"  --since, --until  time window on the line timestamp; --until is exclusive; "
"bare dates are UTC"
msgstr ""
"  --since, --until  Zeitfenster auf dem Zeitstempel der Zeile; --until ist "
"exklusiv; reine Daten gelten als UTC"

#: src/cli/metrics.ts:32
msgid "  --day             one UTC day, same as --since D --until D+1"
msgstr "  --day             ein UTC-Tag, wie --since D --until D+1"

#: src/cli/metrics.ts:33
msgid ""
"  --calls           one row per call: a gap above 60 s between lines starts "
"a new call"
msgstr ""
"  --calls           eine Zeile je Anruf: eine Pause über 60 s zwischen "
"Zeilen beginnt einen neuen Anruf"

#: src/cli/metrics.ts:34
msgid "  --json            machine-readable output"
msgstr "  --json            maschinenlesbare Ausgabe"

#: src/cli/metrics.ts:36
msgid ""
"Percentiles are nearest-rank (always a measured value). A TTS chunk hedged "
"by HedgedTTS can appear twice; lines are not de-duplicated."
msgstr ""
"Perzentile nach Nearest-Rank (immer ein gemessener Wert). Ein von HedgedTTS "
"abgesichertes TTS-Stück kann doppelt vorkommen; Zeilen werden nicht "
"dedupliziert."

