# Copy to .env and fill in. Placeholders only; never commit .env.

# LiveKit server (local stack). Generate a random secret of at least 32 characters,
# e.g. `openssl rand -hex 24`. Any key name works; the key must not contain spaces or colons.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=sprechstunde
LIVEKIT_API_SECRET=

MISTRAL_API_KEY=
# eu | us = Mistral's regional inference (processing stays in that region, 1.1× price);
# empty = the global endpoint, which does not say where a request runs.
SPRECHSTUNDE_MISTRAL_SERVER=
# TTS vendor: mistral (default) | cartesia | openrouter | pocket. Cartesia and OpenRouter need their
# own voice id in SPRECHSTUNDE_TTS_VOICE; openrouter also SPRECHSTUNDE_TTS_MODEL. OpenRouter is for
# testing only. pocket = Kyutai Pocket TTS on this machine (`podman compose --profile pocket up -d`).
SPRECHSTUNDE_TTS_PROVIDER=
SPRECHSTUNDE_TTS_VOICE=
# The name the assistant uses with this voice; replaces the profile's assistantName in the
# greeting, the instructions and the transfer announcement. Empty = the profile's name.
SPRECHSTUNDE_TTS_NAME=
# Optional second voice, same keys with _FALLBACK_: takes whole calls when Pocket has no free
# session, and steps in mid-call when the first voice fails.
SPRECHSTUNDE_TTS_FALLBACK_PROVIDER=
SPRECHSTUNDE_TTS_FALLBACK_VOICE=
SPRECHSTUNDE_TTS_FALLBACK_NAME=
POCKET_TTS_URL=http://127.0.0.1:8090
# Optional second LLM, asked when the first has not answered within the attempt timeout (seconds,
# default 3) or fails. Empty = one model, as before.
SPRECHSTUNDE_LLM_FALLBACK_MODEL=
SPRECHSTUNDE_LLM_ATTEMPT_TIMEOUT=
CARTESIA_API_KEY=
OPENROUTER_API_KEY=
SPRECHSTUNDE_PROFILE=
SPRECHSTUNDE_MODE=echo

# SIP provider (example values are for 1&1 and unverified; adjust to your provider)
SIP_PROVIDER_HOST=tls-sip.1und1.de:5061
SIP_PROVIDER_DOMAIN=
SIP_PROVIDER_USER=
SIP_PROVIDER_PASSWORD=
# The number the provider delivers calls for, as the provider sends it in the INVITE
SIP_PROVIDER_NUMBER=
# sdes (SRTP, keys in SDP) | no (plain RTP). Unverified for 1&1.
SIP_PROVIDER_MEDIA_ENCRYPTION=sdes
# Public IPv4 when Asterisk runs behind NAT (home router); empty on a host with a public address.
# A dynamic DSL address changes on reconnect — update it, or the call has no audio again.
SIP_PUBLIC_ADDRESS=
# yes = talk to the provider over IPv6 (no NAT); overrides SIP_PUBLIC_ADDRESS. Needed behind a
# router that rewrites RTP source ports, e.g. a FRITZ!Box.
SIP_PROVIDER_IPV6=no

# Where a call transfer goes, e.g. +4930…: Asterisk allows only this number, and the agent uses it
# instead of the profile's transfer.target. Empty = the profile target, which Asterisk then refuses.
TRANSFER_TARGET_NUMBER=
# Where the agent sends the REFER for that number: sip:<number>@<this>. Asterisk rejects tel: URIs.
TRANSFER_SIP_HOST=127.0.0.1:5070
# Seconds Asterisk lets LiveKit ring before it answers with the fallback announcement
# (`npm run fallback`). An agent that runs takes about 2 s. Empty = 10.
SPRECHSTUNDE_ANSWER_TIMEOUT=
