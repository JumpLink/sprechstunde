# Kyutai Pocket TTS (MIT code, CC-BY-4.0 weights and voices) behind server.py.
# CPU only: the CPU wheel of torch keeps the image ~1 GB instead of pulling the CUDA build.
FROM docker.io/library/python:3.13-slim-trixie
RUN useradd --create-home --uid 1000 pocket \
 && pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
      pocket-tts==3.3.0 torch==2.14.1+cpu
USER pocket
ENV HF_HOME=/home/pocket/.cache/huggingface POCKET_LANGUAGE=german POCKET_VOICE=juergen
# Weights and the default voice go into the image, so the server starts without network. Needs
# network at build time; the preset voices need no Hugging Face login.
RUN python -c "from pocket_tts import TTSModel; import os; \
m = TTSModel.load_model(language=os.environ['POCKET_LANGUAGE']); \
m.get_state_for_audio_prompt(os.environ['POCKET_VOICE'])"
ENV HF_HUB_OFFLINE=1
WORKDIR /app
COPY server.py ./
CMD ["python", "server.py"]
