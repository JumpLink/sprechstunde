; --- provider line ${LINE_ID} (outbound registration, TLS client) ---
; Auth, registration, aor and endpoint share one name: provider-<line id>.
[provider-${LINE_ID}]
type=auth
auth_type=userpass
username=${LINE_USER}
password=${LINE_PASSWORD}
realm=${LINE_DOMAIN}

[provider-${LINE_ID}]
type=registration
transport=transport-tls-provider
outbound_auth=provider-${LINE_ID}
server_uri=sip:${LINE_HOST}
client_uri=sip:${LINE_USER}@${LINE_DOMAIN}
; 1&1 answers 403 "Contact User und Anrufernummer verschieden" when the Contact user is the
; default "s"; it has to be the registered number.
contact_user=${LINE_USER}
; Tag the Contact with a line id so inbound INVITEs map to the endpoint even when they come
; from another provider host than the one we registered with.
line=yes
endpoint=provider-${LINE_ID}
retry_interval=60
; Without this a 403 (e.g. a password 1&1 has not activated yet) stops registering for good.
fatal_retry_interval=300
expiration=600

[provider-${LINE_ID}]
type=aor
contact=sip:${LINE_HOST};transport=tls

[provider-${LINE_ID}]
type=endpoint
transport=transport-tls-provider
context=from-provider
disallow=all
allow=alaw,ulaw,g722
outbound_auth=provider-${LINE_ID}
aors=provider-${LINE_ID}
from_domain=${LINE_DOMAIN}
from_user=${LINE_USER}
; sdes = SRTP with keys in SDP; no = plain RTP. Unverified for 1&1.
media_encryption=${LINE_MEDIA_ENCRYPTION}
; The dialplan reads these: the line id travels to LiveKit as a header, the number is what the
; LiveKit inbound trunk expects, and a transfer goes out via the line the call came in on.
set_var=SPRECHSTUNDE_LINE=${LINE_ID}
set_var=SPRECHSTUNDE_LINE_NUMBER=${LINE_NUMBER}
${LINE_RTP_IPV6}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
