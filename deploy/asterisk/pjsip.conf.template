; Rendered by entrypoint.sh, which appends one block per provider line (pjsip-line.conf.template).
; Provider values are examples for a TLS trunk (1&1 style) and unverified.

[transport-udp-local]
type=transport
protocol=udp
bind=127.0.0.1:5070

[transport-tls-provider]
type=transport
protocol=tls
bind=0.0.0.0:0
method=tlsv1_2
verify_server=yes
ca_list_file=/etc/ssl/certs/ca-certificates.crt

; --- LiveKit SIP (local, plain UDP) ---
[livekit-aor]
type=aor
contact=sip:127.0.0.1:5060

[livekit]
type=endpoint
transport=transport-udp-local
context=from-livekit
disallow=all
allow=alaw,ulaw,g722
aors=livekit-aor
direct_media=no
rtp_symmetric=yes
media_encryption=no
dtmf_mode=rfc4733
allow_transfer=yes

[livekit-identify]
type=identify
endpoint=livekit
match=127.0.0.1
